---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { site, people } from '../data/site';
import { zonas } from '../data/zonas';

interface Props {
  title?: string;
  titleTail?: string;
  description?: string;
  image?: string;
  schema?: object | object[];
  noindex?: boolean;
  alternates?: { hreflang: string; href: string }[];
}
const {
  title = site.name,
  titleTail,
  description = `${site.name}: vidrio templado, cerramientos, mamparas, divisorias y aberturas de aluminio en ${site.city} y Gran Asunción. Empresa familiar desde ${site.founded}. Presupuesto sin compromiso.`,
  image = '/og-masvidrios.jpg',
  schema,
  noindex = false,
  alternates = [],
} = Astro.props;

// Título estilo "trenbolone" de la guía SEO local: {keyword + ciudad} - MARCA | {servicios + cerca tuyo}.
// La marca queda de ancla en el medio. Cada página pasa su `title` (front) y, opcional, su `titleTail`.
const tail = titleTail ?? 'vidrio templado, cerramientos, mamparas, divisorias de oficina y aberturas de aluminio cerca tuyo';
const fullTitle = title === site.name
  ? `MÁS VIDRIOS - vidriería en ${site.city} y Gran Asunción | ${tail}`
  : `${title} - ${site.name} | ${tail}`;

const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image, site.url).href;

// Equipo como nodos Person (founder + employee) para el knowledge graph.
const persons = people.map((p) => ({
  '@type': 'Person',
  '@id': `${site.url}/#${p.id}`,
  name: p.name,
  jobTitle: p.jobTitle,
  image: `${site.url}${p.photo}`,
  worksFor: { '@id': `${site.url}/#masvidrios` },
}));
const founderPerson = persons[people.findIndex((p) => p.founder)];

// LocalBusiness / GlassMerchant
const negocio = {
  '@context': 'https://schema.org',
  '@type': 'GlassMerchant',
  '@id': `${site.url}/#masvidrios`,
  name: site.name,
  alternateName: 'Más Vidrios',
  slogan: site.tagline,
  url: site.url,
  logo: `${site.url}/brand/logo.png`,
  image: [`${site.url}/brand/logo.png`, `${site.url}/og-masvidrios.jpg`],
  telephone: `+${site.phoneIntl}`,
  email: site.email,
  priceRange: '₲₲',
  foundingDate: String(site.founded),
  founder: founderPerson,
  employee: persons,
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.city,
    addressRegion: site.region,
    addressCountry: site.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  hasMap: `https://www.google.com/maps/search/?api=1&query=${site.geo.lat},${site.geo.lng}`,
  areaServed: [...zonas.map((z) => z.nombre), 'Gran Asunción', 'Paraguay'],
  sameAs: [site.facebook, site.instagram],
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '07:30', closes: '17:30' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '07:30', closes: '12:00' },
  ],
};

// Breadcrumbs automáticos desde la ruta
const segs = Astro.url.pathname.split('/').filter(Boolean);
let acc = '';
const crumbs = [{ name: 'Inicio', url: site.url + '/' }];
segs.forEach((s, i) => {
  acc += '/' + s;
  const name = i === segs.length - 1
    ? (title === site.name ? s : title)
    : s.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
  crumbs.push({ name, url: new URL(acc + '/', site.url).href });
});
const breadcrumb = segs.length ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.url })),
} : null;

const extra = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const allSchema = [negocio, ...(breadcrumb ? [breadcrumb] : []), ...extra];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <!-- Google Analytics 4 (gtag.js directo, sin GTM) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-ZN6NTQGBD2"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-ZN6NTQGBD2');
    </script>
    <!-- Microsoft Clarity (directo, sin GTM) -->
    <script is:inline>
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window,document,"clarity","script","xjbgmljxl4");
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#2478FC" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_PY" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={`${site.name} — vidrio templado, cerramientos y aluminio en ${site.city}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {allSchema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <noscript><style>{`.reveal{opacity:1!important;transform:none!important}`}</style></noscript>
  </head>
  <body>
    <Navbar />
    <main><slot /></main>
    <Footer />
    <script is:inline>
      (function () {
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) {
          document.querySelectorAll('[data-count-to]').forEach(function (el) { el.textContent = el.getAttribute('data-count-to'); });
          document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('is-in'); });
          return;
        }
        function countUp(el) {
          var to = parseInt(el.getAttribute('data-count-to'), 10) || 0, dur = 1200, t0 = null;
          var pre = el.getAttribute('data-pre') || '', post = el.getAttribute('data-post') || '';
          function step(ts) {
            if (!t0) t0 = ts;
            var p = Math.min((ts - t0) / dur, 1);
            el.textContent = pre + Math.round(p * to) + post;
            if (p < 1) requestAnimationFrame(step);
          }
          requestAnimationFrame(step);
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            e.target.classList.add('is-in');
            if (e.target.hasAttribute('data-count-to')) countUp(e.target);
            io.unobserve(e.target);
          });
        }, { threshold: 0.18, rootMargin: '0px 0px -8% 0px' });
        document.querySelectorAll('.reveal, [data-count-to]').forEach(function (el) { io.observe(el); });
      })();
    </script>
    <!-- Lightbox: toda foto de contenido se abre en grande (pedido de Jose, 09-ago). Excluye logos y avatares del equipo. -->
    <script is:inline>
      (function () {
        var main = document.querySelector('main');
        if (!main) return;
        var fotos = [].slice.call(main.querySelectorAll('img')).filter(function (im) {
          return !im.closest('nav') && !im.closest('header') && !im.closest('footer') && !im.closest('.ph') && !/\/brand\//.test(im.getAttribute('src') || '');
        });
        if (!fotos.length) return;
        fotos.forEach(function (im) {
          im.classList.add('zoomable');
          im.setAttribute('role', 'button');
          im.setAttribute('tabindex', '0');
          if (!im.getAttribute('title')) im.setAttribute('title', 'Tocá para ver la foto en grande');
        });

        var box, bImg, bCap, idx = -1, lastFocus = null;

        function textoDe(im) {
          var fig = im.closest('figure');
          var cap = fig && fig.querySelector('figcaption');
          return (cap && cap.textContent.trim()) || im.getAttribute('alt') || '';
        }
        function pintar(i) {
          idx = (i + fotos.length) % fotos.length;
          var im = fotos[idx];
          bImg.src = im.currentSrc || im.src;
          bImg.alt = im.getAttribute('alt') || '';
          bCap.innerHTML = '';
          bCap.appendChild(document.createTextNode(textoDe(im)));
          if (fotos.length > 1) {
            var n = document.createElement('span');
            n.className = 'n';
            n.textContent = (idx + 1) + ' de ' + fotos.length;
            bCap.appendChild(n);
          }
        }
        function armar() {
          box = document.createElement('div');
          box.className = 'lbx';
          box.setAttribute('role', 'dialog');
          box.setAttribute('aria-modal', 'true');
          box.setAttribute('aria-label', 'Foto ampliada');
          box.innerHTML =
            '<figure class="lbx-fig"><img alt="" /><figcaption class="lbx-cap"></figcaption></figure>' +
            '<button class="lbx-x" type="button" aria-label="Cerrar">&times;</button>' +
            (fotos.length > 1
              ? '<button class="lbx-p" type="button" aria-label="Foto anterior">&#8249;</button><button class="lbx-n" type="button" aria-label="Foto siguiente">&#8250;</button>'
              : '');
          bImg = box.querySelector('.lbx-fig img');
          bCap = box.querySelector('.lbx-cap');
          box.addEventListener('click', function (e) {
            if (e.target === box || e.target.classList.contains('lbx-fig')) cerrar();
          });
          box.querySelector('.lbx-x').addEventListener('click', cerrar);
          var p = box.querySelector('.lbx-p'), n = box.querySelector('.lbx-n');
          if (p) p.addEventListener('click', function () { pintar(idx - 1); });
          if (n) n.addEventListener('click', function () { pintar(idx + 1); });
          document.body.appendChild(box);
        }
        function abrir(i) {
          if (!box) armar();
          lastFocus = document.activeElement;
          pintar(i);
          document.body.style.overflow = 'hidden';
          box.classList.add('on');
          box.querySelector('.lbx-x').focus();
        }
        function cerrar() {
          if (!box) return;
          box.classList.remove('on');
          document.body.style.overflow = '';
          if (lastFocus && lastFocus.focus) lastFocus.focus();
          setTimeout(function () { if (box && !box.classList.contains('on')) bImg.removeAttribute('src'); }, 200);
        }
        fotos.forEach(function (im, i) {
          im.addEventListener('click', function () { abrir(i); });
          im.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); abrir(i); }
          });
        });
        document.addEventListener('keydown', function (e) {
          if (!box || !box.classList.contains('on')) return;
          if (e.key === 'Escape') cerrar();
          else if (e.key === 'ArrowRight') pintar(idx + 1);
          else if (e.key === 'ArrowLeft') pintar(idx - 1);
        });
      })();
    </script>
    <!-- Tracking de clics de WhatsApp: evento whatsapp_click a GA4 (numero + mensaje + ubicacion) + tag de sesion Clarity -->
    <script is:inline>
      (function () {
        function waInfo(a) {
          try {
            var u = new URL(a.href);
            if (/(^|\.)wa\.me$/.test(u.hostname)) {
              return { num: u.pathname.replace(/\D/g, ''), msg: u.searchParams.get('text') || '' };
            }
            return { num: (u.searchParams.get('phone') || '').replace(/\D/g, ''), msg: u.searchParams.get('text') || '' };
          } catch (e) { return { num: '', msg: '' }; }
        }
        function waLoc(a) {
          if (a.closest('.ribbon')) return 'ribbon-flotante';
          if (a.closest('footer')) return 'footer';
          if (a.closest('nav') || a.closest('header')) return 'navbar';
          var s = a.closest('section');
          if (s && s.id) return 'section:' + s.id;
          return (a.textContent || '').replace(/\s+/g, ' ').trim().slice(0, 40) || 'link';
        }
        document.addEventListener('click', function (ev) {
          var t = ev.target;
          var a = t && t.closest ? t.closest('a[href*="wa.me"], a[href*="api.whatsapp.com"]') : null;
          if (!a) return;
          var info = waInfo(a);
          var loc = waLoc(a);
          if (typeof window.gtag === 'function') {
            window.gtag('event', 'whatsapp_click', {
              wa_number: info.num,
              wa_message: info.msg,
              button_location: loc,
              page_path: location.pathname
            });
          }
          if (typeof window.clarity === 'function') {
            window.clarity('set', 'whatsapp_click', loc);
          }
        }, true);
      })();
    </script>
  </body>
</html>
